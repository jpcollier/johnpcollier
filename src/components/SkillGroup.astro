---
interface Props {
  label: string;
  skills: string[];
}

const { label, skills } = Astro.props;
---

<div>
  <h4 class="text-xs uppercase tracking-widest text-muted mb-3">{label}</h4>
  <div class="flex flex-wrap gap-2">
    {
      skills.map((skill) => (
        <span class="text-sm bg-surface text-ink/80 px-3 py-1 rounded-sm">
          {skill}
        </span>
      ))
    }
  </div>
</div>
